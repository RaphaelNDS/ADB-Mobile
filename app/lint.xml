<?xml version="1.0" encoding="utf-8"?>
<!-- Avisos do lint que não se aplicam a este app (o resto continua valendo). -->
<lint>
    <!-- O app é só em português, sem traduções: texto direto no layout e no código é o padrão. -->
    <issue id="HardcodedText" severity="ignore" />
    <issue id="SetTextI18n" severity="ignore" />
    <!-- "comando" é português, não "commando". -->
    <issue id="Typos" severity="ignore" />
    <!-- /sdcard aqui é caminho no aparelho ALVO (comandos pelo ADB), não neste aparelho. -->
    <issue id="SdCardPath" severity="ignore" />
    <!-- Campos de comando, IP, porta e código de pareamento: não há o que preencher sozinho. -->
    <issue id="Autofill" severity="ignore" />
    <!-- TrustManager vazio está nas bibliotecas do ADB (libadb, bouncycastle): a conexão com a
         Depuração sem fio usa certificado próprio, conferido pelo pareamento, não por uma CA. -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp=".*\.jar" />
    </issue>
    <!-- Tela única, rolável, com todos os blocos: dividir não compensa. -->
    <issue id="TooManyViews" severity="ignore" />
    <issue id="DisableBaselineAlignment" severity="ignore" />
    <issue id="Overdraw" severity="ignore" />
    <!-- Layouts não usam start/end de propósito para idiomas da direita para a esquerda. -->
    <issue id="RtlEnabled" severity="ignore" />
    <!-- "Há versão mais nova de X": muda com a data, não com o código (o mesmo commit passaria
         hoje e falharia amanhã). Atualizações de versão são revistas à parte. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
