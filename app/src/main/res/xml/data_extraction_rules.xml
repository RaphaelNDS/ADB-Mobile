<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada vai para o backup na nuvem nem para outro aparelho na transferência.
     Os arquivos do app incluem a chave privada do ADB (pareamento com a Depuração sem fio). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
