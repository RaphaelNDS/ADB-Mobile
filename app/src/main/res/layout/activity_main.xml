<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/primary_dark"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_terminal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADB Mobile"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuração de dispositivos via ADB"
                android:textColor="@color/on_primary_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_primary_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Comando -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Overline"
                    android:layout_marginBottom="8dp"
                    android:text="Comando" />

                <Spinner
                    android:id="@+id/preset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:spinnerMode="dialog"
                    android:prompt="@string/choose_command" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="adb shell" />

                <EditText
                    android:id="@+id/command"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="digite o comando"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minHeight="46dp"
                    android:padding="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/disabled"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/saveCommand"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="40dp"
                        android:layout_weight="1"
                        android:text="Salvar comando"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/deleteCommand"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Excluir"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="6dp"
                    android:text="Escolha um comando pronto ou edite o texto acima. Comandos de app usam o pacote informado em &quot;Log automático&quot;. Use &quot;Salvar comando&quot; para guardar o texto com um nome em &quot;Meus comandos&quot;." />
            </LinearLayout>

            <!-- Aparelho alvo -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Overline"
                    android:layout_marginBottom="8dp"
                    android:text="Aparelho alvo" />

                <RadioGroup
                    android:id="@+id/target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_track"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/targetLocal"
                        style="@style/Segment"
                        android:text="Este aparelho" />

                    <RadioButton
                        android:id="@+id/targetRemote"
                        style="@style/Segment"
                        android:text="Outro aparelho" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/remoteBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_width="0dp"
                            android:layout_marginBottom="0dp"
                            android:layout_weight="1"
                            android:text="Aparelhos salvos" />

                        <TextView
                            android:id="@+id/selectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:padding="4dp"
                            android:text="Marcar todos"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/devicesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/devicesEmpty"
                        style="@style/Body"
                        android:layout_marginTop="4dp"
                        android:text="Nenhum aparelho salvo. Preencha abaixo e toque em &quot;Salvar aparelho&quot;." />

                    <TextView
                        android:id="@+id/devicesSummary"
                        style="@style/Body"
                        android:layout_marginTop="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <TextView
                        style="@style/FieldLabel"
                        android:text="Nome (opcional)" />

                    <EditText
                        android:id="@+id/deviceName"
                        style="@style/Field"
                        android:layout_marginBottom="10dp"
                        android:hint="Quiosque da entrada"
                        android:inputType="textCapSentences" />

                    <!-- IP e porta: empilhados no celular, lado a lado no tablet (layout-sw480dp) -->
                    <include
                        layout="@layout/target_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/saveDevice"
                        style="@style/ButtonOutline"
                        android:layout_marginTop="10dp"
                        android:text="Salvar aparelho" />

                    <TextView
                        style="@style/Body"
                        android:layout_marginTop="10dp"
                        android:text="Android 11+: use o IP e a porta exibidos em &quot;Depuração por Wi-Fi&quot; no aparelho alvo (a porta muda quando a depuração reinicia) e faça o pareamento uma vez.\nAndroid 10 ou anterior: execute &quot;adb tcpip 5555&quot; uma vez pelo PC, use a porta 5555 e autorize a depuração na tela do alvo." />
                </LinearLayout>
            </LinearLayout>

            <!-- 1. Pareamento -->
            <LinearLayout
                android:id="@+id/pairCard"
                style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <TextView
                        style="@style/StepBadge"
                        android:text="1" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Pareamento" />

                    <TextView
                        style="@style/Overline"
                        android:text="Somente na 1ª vez" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pairingHelp"
                    style="@style/Body" />

                <Button
                    android:id="@+id/pairNotification"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="14dp"
                    android:text="Parear via notificação" />

                <Button
                    android:id="@+id/pairQr"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="14dp"
                    android:text="Parear por QR code"
                    android:visibility="gone" />

                <!-- Alinhados pela base: se um rótulo quebrar (celular com fonte grande), os campos
                     continuam na mesma altura. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Porta de pareamento" />

                        <EditText
                            android:id="@+id/pairPort"
                            style="@style/Field"
                            android:hint="37000"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Código (6 dígitos)" />

                        <EditText
                            android:id="@+id/pairCode"
                            style="@style/Field"
                            android:hint="000000"
                            android:inputType="number"
                            android:maxLength="6" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/pairManual"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="12dp"
                    android:text="Parear" />
            </LinearLayout>

            <!-- 2. Execução -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <TextView
                        style="@style/StepBadge"
                        android:text="2" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Execução" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/run"
                    style="@style/ButtonPrimary"
                    android:text="Executar comando" />

                <Button
                    android:id="@+id/runBatch"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Executar vários comandos" />

                <Button
                    android:id="@+id/read"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Ler valor atual" />

                <Button
                    android:id="@+id/saveLog"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Gerar log do aparelho (.txt)" />

                <Button
                    android:id="@+id/liveLogcat"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Logcat ao vivo" />

                <Button
                    android:id="@+id/installApk"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Instalar APK (.apk)" />

                <Button
                    android:id="@+id/kioskSetup"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Preparar Kiosk (instalar + Device Owner)" />

                <Button
                    android:id="@+id/inventory"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Inventário dos aparelhos (Kiosk, bateria, espaço)" />

                <Button
                    android:id="@+id/schedule"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Agendar comando diário" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pushFile"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Enviar arquivo" />

                    <Button
                        android:id="@+id/pullFile"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="Baixar arquivo" />
                </LinearLayout>

                <Button
                    android:id="@+id/screenshot"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Capturar tela" />

                <Button
                    android:id="@+id/mirror"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Ver tela do aparelho (com toque)" />
            </LinearLayout>

            <!-- 3. Log automático -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/CardHeader">

                    <TextView
                        style="@style/StepBadge"
                        android:text="3" />

                    <TextView
                        style="@style/CardTitle"
                        android:text="Log automático" />
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:text="Salva o log completo do aparelho alvo na pasta escolhida sempre que o app abaixo for aberto ou reiniciar nele (se já estiver aberto, salva ao iniciar). Deixa na pasta os 10 logs mais recentes do app e move os mais antigos para a subpasta &quot;antigos&quot; (nada é apagado; logs com CRASH ou ANR ficam sempre na pasta). Continua funcionando com o ADB Mobile em segundo plano." />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="Pacote do app" />

                <EditText
                    android:id="@+id/monitorPackage"
                    style="@style/Field"
                    android:hint="br.com.backupautomacao.kiosk"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/chooseApp"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Escolher app" />

                    <Button
                        android:id="@+id/appInfo"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="Informações do app" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logFolder"
                    style="@style/Body"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/chooseFolder"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Escolher pasta dos logs" />

                <Button
                    android:id="@+id/toggleMonitor"
                    style="@style/ButtonPrimary"
                    android:layout_marginTop="10dp"
                    android:text="Iniciar monitoramento" />
            </LinearLayout>

            <!-- Configuração: exportar/importar -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Overline"
                    android:layout_marginBottom="4dp"
                    android:text="Configuração" />

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Leva os comandos salvos, os aparelhos salvos e o pacote do Log automático para outro aparelho (arquivo .json)." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/exportConfig"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Exportar" />

                    <Button
                        android:id="@+id/importConfig"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="Importar" />
                </LinearLayout>

                <Button
                    android:id="@+id/checkUpdate"
                    style="@style/ButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Verificar atualização" />
            </LinearLayout>

            <!-- Registro -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Overline"
                    android:text="Registro de atividades" />

                <!-- Links numa linha própria: ao lado do título, no celular, espremiam o título. -->
                <LinearLayout
                    style="@style/CardHeader"
                    android:layout_marginBottom="6dp"
                    android:gravity="end|center_vertical">

                    <TextView
                        android:id="@+id/searchLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Buscar"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/shareLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Compartilhar"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/clearLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Limpar"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_console"
                    android:fontFamily="monospace"
                    android:minHeight="120dp"
                    android:padding="12dp"
                    android:textColor="@color/console_text"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
