<?xml version="1.0" encoding="utf-8"?>
<!-- Android 5 (API 21-22): sem width/gravity no item, a faixa de 4dp ocuparia o fundo todo.
     Aqui a faixa é a cor por baixo e o fundo começa 4dp depois. Android 6+: drawable-v23. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/info" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/info_bg" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
